{
  "name": "ramus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "test": "vitest run",
    "deploy": "wrangler deploy --config ../wrangler.jsonc",
    "build:cloudflare": "npm run build && node scripts/cloudflare-assets.mjs",
    "check:deploy": "npm run build:cloudflare && wrangler deploy --config ../wrangler.jsonc --dry-run"
  },
  "dependencies": {
    "@xmtp/browser-sdk": "^6.1.2",
    "ethers": "^6.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^4.1.12",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  }
}
