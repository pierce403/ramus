# POIDH
POIDH_API_BASE=https://api.poidh.xyz
POIDH_APP_BASE=https://poidh.xyz
POIDH_CHAIN_ID=8453
POIDH_CHAIN_SLUG=base
POIDH_RPC_URL=
POIDH_API_KEY=
# Required: Infura Base mainnet key (used for POIDH_RPC_URL and ETH_MAINNET_RPC_URL).
INFURA_API_KEY=

# Wallet
WALLET_PRIVATE_KEY=
WALLET_KEY_PATH=./state/ramus_wallet.key
WALLET_ADDRESS=
OPERATOR_ENS=
OPERATOR_ADDRESS=0x7ab874Eeef0169ADA0d225E9801A3FfFfa26aAC3
ETH_MAINNET_RPC_URL=

# XMTP
XMTP_ENV=production
XMTP_DB_PATH=./.xmtp
XMTP_WALLET_KEY=

# Bot runtime
STATE_DB_PATH=./state/ramus.sqlite
LOG_LEVEL=INFO
# Auto-run the bounty loop (1/0)
AUTO_RUN=1
# Reward uses the chain's native token (ETH on Base/Arbitrum, DEGEN on Degen).
# If both are blank, auto-run uses ~10% of the wallet balance.
BOUNTY_REWARD_WEI=
BOUNTY_REWARD_ETH=

AI_SCORE_ENDPOINT=
VENICE_API_KEY=
VENICE_MODEL=llama-3.3-70b
VENICE_BASE_URL=https://api.venice.ai/api/v1

AUDIT_DIR=./docs/bounty-runs

MANUAL_OVERRIDE_PATH=./manual_override.json
